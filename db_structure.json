{
  "users": {
    "id": "uuid PRIMARY KEY",
    "first_name": "string",
    "last_name": "string",
    "email": "string UNIQUE NOT NULL",
    "email_verified": "boolean DEFAULT false",
    "phone": "string | null",
    "country_code": "string | null",
    "is_active": "boolean DEFAULT true",  // ← ADD: soft delete/ban
    "is_locked": "boolean DEFAULT false",  // ← ADD: account lockout
    "locked_until": "timestamp | null",    // ← ADD: temporary locks
    "failed_login_count": "integer DEFAULT 0", // ← ADD: track failures
    "last_login_at": "timestamp | null",   // ← ADD: user activity
    "created_at": "timestamp",
    "updated_at": "timestamp"
  },
  
  "passwords": {
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) ON DELETE CASCADE",
    "hashed_password": "string NOT NULL",
    "password_changed_at": "timestamp",    // ← ADD: force re-auth
    "previous_passwords": "text[] | null", // ← ADD: prevent reuse
    "created_at": "timestamp"
  },
  
  "user_identities": {
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) ON DELETE CASCADE",
    "provider": "enum('google', 'github', 'apple', 'microsoft')",
    "provider_user_id": "string NOT NULL",
    "provider_email": "string",            // ← ADD: OAuth email
    "access_token": "text | null",         // ← OPTIONAL: store encrypted
    "refresh_token": "text | null",        // ← OPTIONAL: store encrypted
    "created_at": "timestamp",
    "updated_at": "timestamp",
    "UNIQUE(provider, provider_user_id)"   // ← ADD: prevent duplicates
  },
  
  "refresh_tokens": {
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) ON DELETE CASCADE",
    "hashed_token": "string NOT NULL UNIQUE",
    "device_info": "jsonb | null",         // ← ADD: browser/device tracking
    "ip_address": "string",                // ← ADD: security tracking
    "revoked": "boolean DEFAULT false",
    "revoked_at": "timestamp | null",      // ← ADD: when revoked
    "last_used_at": "timestamp",           // ← ADD: activity tracking
    "created_at": "timestamp",
    "expires_at": "timestamp",
    "INDEX(user_id, revoked)",             // ← ADD: query optimization
    "INDEX(expires_at)"                    // ← ADD: cleanup queries
  },
  
  "login_attempts": {
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) | null", // ← CHANGE: allow null for failed emails
    "email": "string",
    "ip_address": "string NOT NULL",
    "user_agent": "string",                // ← ADD: browser info
    "successful": "boolean NOT NULL",
    "failure_reason": "string | null",     // ← ADD: why it failed
    "created_at": "timestamp",
    "INDEX(email, created_at)",            // ← ADD: rate limiting queries
    "INDEX(ip_address, created_at)"        // ← ADD: IP-based rate limiting
  },
  
  "password_reset_tokens": {
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) ON DELETE CASCADE",
    "hashed_token": "string NOT NULL UNIQUE",
    "ip_address": "string",                // ← ADD: security audit
    "expires_at": "timestamp NOT NULL",
    "used_at": "timestamp | null",
    "created_at": "timestamp",
    "INDEX(expires_at)"                    // ← ADD: cleanup queries
  },
  
  "email_verification_tokens": {
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) ON DELETE CASCADE",
    "hashed_token": "string NOT NULL UNIQUE",
    "email": "string NOT NULL",            // ← ADD: verify specific email
    "expires_at": "timestamp NOT NULL",
    "used_at": "timestamp | null",
    "created_at": "timestamp",
    "INDEX(expires_at)"                    // ← ADD: cleanup queries
  },
  
  "sessions": {                            // ← NEW TABLE: active sessions
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) ON DELETE CASCADE",
    "refresh_token_id": "uuid REFERENCES refresh_tokens(id)",
    "ip_address": "string",
    "user_agent": "string",
    "last_activity_at": "timestamp",
    "created_at": "timestamp",
    "expires_at": "timestamp",
    "INDEX(user_id, last_activity_at)"
  },
  
  "audit_logs": {                          // ← NEW TABLE: security events
    "id": "uuid PRIMARY KEY",
    "user_id": "uuid REFERENCES users(id) | null",
    "event_type": "enum('login', 'logout', 'password_change', 'email_change', 'account_locked', etc.)",
    "ip_address": "string",
    "user_agent": "string",
    "metadata": "jsonb",
    "created_at": "timestamp",
    "INDEX(user_id, created_at)",
    "INDEX(event_type, created_at)"
  }
}